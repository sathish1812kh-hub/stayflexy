// ─── PMS Feature Depth (Checklist 3.9-3.14) ─────────────────────────────────
// RatePlan/Season/Restriction (3.9) — Pricing Engine
// Promotion/CouponRedemption (3.10) — Pricing Engine
// Folio/NightAudit (3.12) — Payment Service
// Loyalty (3.13) — Booking/Guest domain
// GroupBlock (3.14) — Booking domain

// ─── 3.9: Rate Plan ──────────────────────────────────────────────────────────

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum FolioStatus {
  OPEN
  CLOSED
  VOID
}

enum FolioEntryType {
  CHARGE
  PAYMENT
  ADJUSTMENT
  REFUND
  TAX
  FEE
}

enum NightAuditStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum LoyaltyTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
  DIAMOND
}

enum LoyaltyTransactionType {
  EARN
  REDEEM
  ADJUSTMENT
  EXPIRE
  BONUS
}

enum GroupBlockStatus {
  PENDING
  CONFIRMED
  CANCELLED
  RELEASED
  EXPIRED
}

// ─── RatePlan ────────────────────────────────────────────────────────────────

model RatePlan {
  id                String    @id @default(uuid())
  organizationId    String
  hotelId           String
  roomTypeId        String?
  name              String    @db.VarChar(200)
  code              String    @db.VarChar(50)
  description       String?   @db.VarChar(500)
  seasonStart       DateTime? @db.Date
  seasonEnd         DateTime? @db.Date
  baseRate          Decimal   @db.Decimal(10, 2)
  currency          String    @default("USD") @db.VarChar(3)
  minStay           Int       @default(1)
  maxStay           Int?
  closedToArrival   Boolean   @default(false)
  closedToDeparture Boolean   @default(false)
  isActive          Boolean   @default(true)
  createdById       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  restrictions Restriction[] @relation("RatePlanRestrictions")

  @@unique([hotelId, code])
  @@index([organizationId])
  @@index([hotelId])
  @@index([roomTypeId])
  @@index([code])
  @@index([isActive])
  @@index([deletedAt])
  @@map("rate_plans")
}

// ─── Season ──────────────────────────────────────────────────────────────────

model Season {
  id             String    @id @default(uuid())
  organizationId String
  hotelId        String
  name           String    @db.VarChar(100)
  code           String    @db.VarChar(50)
  description    String?   @db.VarChar(500)
  startDate      DateTime  @db.Date
  endDate        DateTime  @db.Date
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  @@unique([hotelId, code])
  @@index([organizationId])
  @@index([hotelId])
  @@index([isActive])
  @@index([deletedAt])
  @@map("seasons")
}

// ─── Restriction ─────────────────────────────────────────────────────────────

model Restriction {
  id                String    @id @default(uuid())
  organizationId    String
  hotelId           String
  ratePlanId        String?
  ratePlan          RatePlan? @relation("RatePlanRestrictions", fields: [ratePlanId], references: [id], onDelete: SetNull)
  roomTypeId        String?
  restrictionDate   DateTime  @db.Date
  minStay           Int?
  maxStay           Int?
  closedToArrival   Boolean   @default(false)
  closedToDeparture Boolean   @default(false)
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([organizationId])
  @@index([hotelId])
  @@index([ratePlanId])
  @@index([roomTypeId])
  @@index([restrictionDate])
  @@index([isActive])
  @@map("restrictions")
}

// ─── 3.10: Promotion / CouponRedemption ─────────────────────────────────────

model Promotion {
  id             String       @id @default(uuid())
  organizationId String
  hotelId        String?
  code           String       @unique @db.VarChar(50)
  name           String       @db.VarChar(200)
  description    String?      @db.Text
  discountType   DiscountType
  discountValue  Decimal      @db.Decimal(10, 2)
  minNights      Int          @default(1)
  validFrom      DateTime     @db.Date
  validTo        DateTime     @db.Date
  maxUses        Int?
  usedCount      Int          @default(0)
  isActive       Boolean      @default(true)
  createdById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  redemptions CouponRedemption[] @relation("PromotionRedemptions")

  @@index([organizationId])
  @@index([hotelId])
  @@index([code])
  @@index([isActive])
  @@index([validFrom, validTo])
  @@index([deletedAt])
  @@map("promotions")
}

model CouponRedemption {
  id              String    @id @default(uuid())
  promotionId     String
  promotion       Promotion @relation("PromotionRedemptions", fields: [promotionId], references: [id], onDelete: Cascade)
  bookingId       String?
  organizationId  String
  hotelId         String?
  guestId         String?
  discountApplied Decimal   @db.Decimal(10, 2)
  redeemedAt      DateTime  @default(now())
  redeemedById    String?

  @@index([promotionId])
  @@index([bookingId])
  @@index([organizationId])
  @@index([hotelId])
  @@index([guestId])
  @@index([redeemedAt])
  @@map("coupon_redemptions")
}

// ─── 3.12: Folio / FolioEntry / NightAudit ───────────────────────────────────

model Folio {
  id             String      @id @default(uuid())
  organizationId String
  hotelId        String
  bookingId      String
  folioNumber    String      @unique @db.VarChar(50)
  status         FolioStatus @default(OPEN)
  balance        Decimal     @default(0) @db.Decimal(12, 2)
  currency       String      @default("USD") @db.VarChar(3)
  closedAt       DateTime?
  closedById     String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  entries FolioEntry[] @relation("FolioEntries")

  @@index([organizationId])
  @@index([hotelId])
  @@index([bookingId])
  @@index([status])
  @@index([folioNumber])
  @@map("folios")
}

model FolioEntry {
  id             String         @id @default(uuid())
  folioId        String
  folio          Folio          @relation("FolioEntries", fields: [folioId], references: [id], onDelete: Cascade)
  organizationId String
  hotelId        String
  entryType      FolioEntryType
  description    String         @db.VarChar(500)
  amount         Decimal        @db.Decimal(12, 2)
  balanceAfter   Decimal?       @db.Decimal(12, 2)
  referenceId    String?        @db.VarChar(255)
  referenceType  String?        @db.VarChar(100)
  createdById    String?
  createdAt      DateTime       @default(now())

  @@index([folioId])
  @@index([organizationId])
  @@index([hotelId])
  @@index([entryType])
  @@index([createdAt])
  @@map("folio_entries")
}

model NightAudit {
  id             String           @id @default(uuid())
  organizationId String
  hotelId        String
  auditDate      DateTime         @db.Date
  status         NightAuditStatus @default(PENDING)
  closedById     String?
  entries        Json? // summary JSON of audit entries
  totalRevenue   Decimal?         @db.Decimal(14, 2)
  totalPayments  Decimal?         @db.Decimal(14, 2)
  folioCount     Int              @default(0)
  startedAt      DateTime?
  completedAt    DateTime?
  errorMessage   String?          @db.VarChar(2000)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([hotelId, auditDate])
  @@index([organizationId])
  @@index([hotelId])
  @@index([status])
  @@index([auditDate])
  @@map("night_audits")
}

// ─── 3.13: Loyalty ───────────────────────────────────────────────────────────

model LoyaltyAccount {
  id             String      @id @default(uuid())
  guestId        String      @unique
  organizationId String
  hotelId        String?
  tier           LoyaltyTier @default(BRONZE)
  points         Int         @default(0)
  lifetimePoints Int         @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  deletedAt      DateTime?

  transactions LoyaltyTransaction[] @relation("LoyaltyAccountTransactions")

  @@index([organizationId])
  @@index([guestId])
  @@index([tier])
  @@index([deletedAt])
  @@map("loyalty_accounts")
}

model LoyaltyTransaction {
  id               String                 @id @default(uuid())
  loyaltyAccountId String
  loyaltyAccount   LoyaltyAccount         @relation("LoyaltyAccountTransactions", fields: [loyaltyAccountId], references: [id], onDelete: Cascade)
  organizationId   String
  guestId          String
  type             LoyaltyTransactionType
  points           Int
  balanceAfter     Int
  referenceType    String?                @db.VarChar(100) // BOOKING, REDEMPTION, ADJUSTMENT
  referenceId      String?                @db.VarChar(255)
  description      String?                @db.VarChar(500)
  createdAt        DateTime               @default(now())
  createdById      String?

  @@index([loyaltyAccountId])
  @@index([organizationId])
  @@index([guestId])
  @@index([type])
  @@index([createdAt])
  @@map("loyalty_transactions")
}

// ─── 3.14: GroupBlock ────────────────────────────────────────────────────────

model GroupBlock {
  id             String           @id @default(uuid())
  organizationId String
  hotelId        String
  name           String           @db.VarChar(200)
  code           String           @db.VarChar(50)
  description    String?          @db.Text
  roomTypeId     String?
  blockedRooms   Int              @default(1)
  startDate      DateTime         @db.Date
  endDate        DateTime         @db.Date
  status         GroupBlockStatus @default(PENDING)
  createdById    String?
  releasedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?

  @@unique([hotelId, code])
  @@index([organizationId])
  @@index([hotelId])
  @@index([roomTypeId])
  @@index([code])
  @@index([status])
  @@index([startDate, endDate])
  @@index([deletedAt])
  @@map("group_blocks")
}
